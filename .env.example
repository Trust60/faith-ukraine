# ── Payload + Supabase Postgres ─────────────────────────────────────────────
# Рядок підключення до Postgres (Supabase).
# Для dev і міграцій бери SESSION-пулер або пряме підключення (порт 5432):
# транзакційний пулер (порт 6543, pgBouncer) не дружить з prepared statements
# драйвера pg і ламає міграції Payload.
DATABASE_URI=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Секрет Payload — будь-який довгий випадковий рядок (напр. `openssl rand -hex 32`).
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── Supabase Storage (S3-сумісний) ──────────────────────────────────────────
# Заповнити на КРОЦІ 2, коли перемикаємо фото товарів з локального диска на
# Supabase Storage (плагін @payloadcms/storage-s3). Ключі: Supabase → Storage →
# S3 Access Keys; бакет створити заздалегідь.
# S3_BUCKET=faith-products
# S3_REGION=<region>            # напр. eu-central-1
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/faith-products
